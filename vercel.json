{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "frontend/index.html",
          "frontend/styles.css",
          "livekit-client.js"
        ]
      }
    },
    { "src": "client/app.js", "use": "@vercel/static" },
    { "src": "client/constants.js", "use": "@vercel/static" },
    { "src": "client/utils.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
