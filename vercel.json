{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend-v2/dist/assets/:path*"
    },
    {
      "source": "/krisp/:path*",
      "destination": "/frontend-v2/dist/krisp/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/frontend-v2/dist/index.html"
    }
  ]
}
