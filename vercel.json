{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend-v2/dist/assets/$1"
    },
    {
      "source": "/(.*\\.(js|css|map|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|json|txt))",
      "destination": "/frontend-v2/dist/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend-v2/dist/index.html"
    }
  ]
}
