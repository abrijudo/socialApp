# Copia este archivo como .env y rellena los valores
# Consíguelos en: https://cloud.livekit.io → tu proyecto → Settings → Keys

LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase
# URL y clave anon (pública): JWT para el cliente y para verificar sesión en el backend (/api/config, auth middleware).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role solo en servidor (nunca en el navegador)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cliente (Vite) y web en producción: despliegue (mismo host que reescribe /api en Vercel)
# Sin barra final. Si está vacío, se usa el fallback de `apiOrigin`.
VITE_API_ORIGIN=

# Solo proceso principal de Electron (no se embebe en el bundle Vite). Anula el origen del API
# al abrir un .exe instalado sin recompilar; deja vacío para usar Vercel por defecto.
ELECTRON_API_ORIGIN=

# Publicar el instalador a GitHub Releases: `npm run electron:build` en frontend-v2 carga este .env.
# Crea un token en GitHub → Settings → Developer settings → Personal access tokens (scope `repo`, o fine-grained: Contents R/W en este repo).
# Nombre requerido por electron-builder: GH_TOKEN o GITHUB_TOKEN (también se admite Github_Token como alias).
# No subas el token al repositorio.
GH_TOKEN=
