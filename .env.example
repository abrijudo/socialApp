# Copia este archivo como .env y rellena los valores
# Consíguelos en: https://cloud.livekit.io → tu proyecto → Settings → Keys

LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase
# URL y clave anon (pública): JWT para el cliente y para verificar sesión en el backend (/api/config, auth middleware).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role solo en servidor (nunca en el navegador)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cliente (Vite) y Electron empaquetado: URL pública de tu despliegue (mismo host que reescribe /api en Vercel)
# Sin barra final. Ejemplo: https://tu-proyecto.vercel.app
VITE_API_ORIGIN=
