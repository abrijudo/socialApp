# Copia este fichero como ".env" (en la carpeta /agent) y rellena los valores.
# El agente NO usa claves hardcodeadas: todo se lee de estas variables.

# --- LiveKit (obtenlos en https://cloud.livekit.io → tu proyecto → Settings → Keys) ---
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI (https://platform.openai.com/api-keys) ---
# Se usa para el modelo Realtime (gpt-realtime).
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Opcional ---
# Nivel de log (DEBUG, INFO, WARNING, ERROR). Por defecto INFO.
# LOG_LEVEL=INFO
