{
  "name": "mini-discord",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "build": "cd frontend-v2 && npm install && npm run build",
    "start": "node server.js",
    "test": "start-server-and-test start http://localhost:3000/api/health test:api",
    "test:api": "node scripts/test-api.js",
    "test:frontend": "npm --prefix frontend-v2 test",
    "test:e2e": "npx playwright test",
    "test:e2e:client": "npm run e2e --prefix frontend-v2",
    "test:all": "node scripts/test-all.mjs",
    "test:all:run": "node scripts/run-all-tests.mjs",
    "dev": "npm run dev:api",
    "dev:api": "nodemon --watch server.js --watch backend server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "link-preview-js": "^4.0.0",
    "livekit-client": "^2.17.2",
    "livekit-server-sdk": "^2.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "nodemon": "^3.1.14",
    "start-server-and-test": "^2.1.5"
  },
  "build": {
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
