# Copia como `.env.production` antes de `npm run build` o `npm run electron:publish`.
#
# No necesitas otro servidor: tu API ya está en el MISMO proyecto Vercel
# (rewrites `/api` → `api/index.js`). Usa la URL pública de tu despliegue:
#
#   VITE_API_ORIGIN=https://tu-proyecto.vercel.app
#   (o tu dominio custom, sin barra final y sin /api)
#
VITE_API_ORIGIN=https://tu-proyecto.vercel.app
