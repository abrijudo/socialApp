{
  "name": "social-club",
  "private": true,
  "version": "0.1.41",
  "description": "Cliente de escritorio (Electron)",
  "author": "abrijudo",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && cross-env NODE_ENV=production vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:codegen": "playwright codegen http://127.0.0.1:5173",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n api,vite,electron -c blue,green,magenta \"npm run dev:api --prefix ..\" \"cross-env ELECTRON_DEV=1 vite\" \"wait-on http-get://localhost:3000/api/health http-get://localhost:5174 && cross-env ELECTRON_START_URL=http://localhost:5174/ electron .\"",
    "electron:start": "electron .",
    "electron:pack": "npm run build && node scripts/ensure-electron-pack-assets.mjs && electron-builder --dir",
    "electron:dist": "npm run build && node scripts/ensure-electron-pack-assets.mjs && electron-builder",
    "electron:publish": "node scripts/electron-publish.mjs",
    "electron:build": "npm run electron:dist"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@livekit/components-core": "^0.12.13",
    "@livekit/components-react": "^2.9.20",
    "@livekit/components-styles": "^1.2.0",
    "@livekit/krisp-noise-filter": "^0.3.4",
    "@supabase/supabase-js": "^2.101.1",
    "application-loopback": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "es-define-property": "^1.0.1",
    "livekit-client": "^2.18.1",
    "lucide-react": "^1.7.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "^4.18.5",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "electron": "^39.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-static-copy": "^4.0.1",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abrijudo/socialApp.git"
  },
  "build": {
    "appId": "com.socialclub.desktop",
    "productName": "Social Club",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "dist/**",
      "electron/**",
      "node_modules/**",
      "build/icon.png",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!src/**",
      "!**/*.{ts,tsx,cts,mts}",
      "!**/tsconfig*.json",
      "!**/vite.config.*",
      "!**/vitest.config.*",
      "!**/eslint.config.*",
      "!**/.git/**",
      "!**/.github/**",
      "!**/release/**",
      "!**/*.test.*"
    ],
    "asarUnpack": [
      "**/node_modules/application-loopback/**/*"
    ],
    "forceCodeSigning": false,
    "win": {
      "icon": "../build/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "../build/icon.ico",
      "uninstallerIcon": "../build/icon.ico",
      "installerSidebar": "../build/installerSidebar.bmp",
      "uninstallerSidebar": "../build/installerSidebar.bmp",
      "installerHeader": "../build/installerHeader.bmp",
      "installerHeaderIcon": "../build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "abrijudo",
        "repo": "socialApp"
      }
    ]
  }
}